# 계정/친구/진행도 저장용 Supabase(Postgres) 연결 문자열. 절대 커밋하지 마세요.
# Supabase 대시보드 > 프로젝트(rzelqkcsfzotzuwjmnnz) > Connect > "Session pooler"(포트 5432) 문자열을 복사해서
# [YOUR-PASSWORD] 자리에 DB 비밀번호를 넣으세요(대괄호도 지움). Render는 IPv4만 되므로 "Direct connection"
# (db.<ref>.supabase.co, IPv6 전용)은 쓰면 안 돼요.
# - 비밀번호에 # / ? % @ 같은 특수문자가 있으면 URL 인코딩해야 해요(# → %23, / → %2F, ? → %3F, % → %25, @ → %40).
#   가장 쉬운 방법은 Supabase에서 영문+숫자로만 된 비밀번호로 재설정하는 것.
# - ?sslmode=... 는 붙이지 마세요. 암호화(TLS)는 서버(server/db.js)가 Supabase 인증서로 직접 켜요.
# 형태: postgresql://postgres.rzelqkcsfzotzuwjmnnz:[YOUR-PASSWORD]@aws-?-[리전].pooler.supabase.com:5432/postgres
# 테이블과 기준 데이터(서식지/종/미션)는 빈 DB에 서버가 처음 뜰 때 자동으로 만들어진다.
DATABASE_URL=

# iNaturalist Computer Vision API 인증. 절대 커밋하지 마세요. (자세한 방법은 SETUP.md 6번)
# 권장: OAuth 앱으로 받은 만료 없는 액세스 토큰 — 서버가 24시간짜리 JWT를 알아서 갱신한다.
#       scripts/inat-get-token.mjs로 한 번만 받으면 된다.
INAT_OAUTH_ACCESS_TOKEN=
# 예전 방식: https://www.inaturalist.org/users/api_token 에서 매일 복사하는 JWT.
# 위 INAT_OAUTH_ACCESS_TOKEN을 넣으면 이 값은 무시되니 지워도 돼요.
INATURALIST_JWT=
# (비권장) 서버가 직접 비밀번호로 액세스 토큰을 받게 하려면 넷 다 채운다.
# INAT_APP_ID=
# INAT_APP_SECRET=
# INAT_USERNAME=
# INAT_PASSWORD=

# 프록시 서버 포트 (선택, 기본 5174)
PORT=5174

# 탐험 화면 동네 생태 지도(NeighborhoodMap)용 Google Maps JS API 키
VITE_GOOGLE_MAPS_API_KEY=

# AI 말벗 챗봇(/chat)용 OpenAI API 키. 절대 커밋하지 마세요.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# 그림 판별(CLIP) 설정 (선택)
# CLIP_ENABLED=false  → 그림 판별 기능을 끔 (Render 무료처럼 CPU/메모리가 부족해 로그인까지 느려질 때)
# CLIP_PRELOAD=true   → 서버 시작 시 모델을 미리 불러옴 (기본은 첫 요청 때 불러옴, Render 무료에선 쓰지 말 것)
# CLIP_DTYPE=fp32     → 원본 정밀도 모델 사용 (기본 q8, Render 무료 512MB에서는 q8 권장)

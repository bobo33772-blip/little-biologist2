# 계정/친구/진행도 저장용 Supabase(Postgres) 연결 문자열. 절대 커밋하지 마세요.
# Supabase 대시보드 > Connect > Session pooler(포트 5432) 문자열을 그대로 넣으세요.
# 예: postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
DATABASE_URL=

# iNaturalist Computer Vision API 개인 토큰 (predict_insect.py 참고)
# https://www.inaturalist.org 에서 발급받은 값을 넣으세요. 절대 커밋하지 마세요.
INATURALIST_JWT=

# 프록시 서버 포트 (선택, 기본 5174)
PORT=5174

# 탐험 화면 동네 생태 지도(NeighborhoodMap)용 Google Maps JS API 키
VITE_GOOGLE_MAPS_API_KEY=

# AI 말벗 챗봇(/chat)용 OpenAI API 키. 절대 커밋하지 마세요.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# 그림 판별(CLIP) 설정 (선택)
# CLIP_ENABLED=false  → 그림 판별 기능을 끔 (Render 무료처럼 CPU/메모리가 부족해 로그인까지 느려질 때)
# CLIP_PRELOAD=true   → 서버 시작 시 모델을 미리 불러옴 (기본은 첫 요청 때 불러옴, Render 무료에선 쓰지 말 것)
# CLIP_DTYPE=fp32     → 원본 정밀도 모델 사용 (기본 q8, Render 무료 512MB에서는 q8 권장)
